{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run game",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/main.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Check Python syntax",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "compileall",
                "-q",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        }
    ]
}